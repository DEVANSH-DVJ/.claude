%   Here we implement the scale=MatchLowercase option.
%   If this is given, we must compute the correct value of
%   the "\FranklinGothic@scale" parameter before loading the .fd files;
%   but to determine that value we of course need the font's x-height.
%   To avoid triggering the loading of .fd files,
%   we use plain TeX's \font primitive to load the testfont.
%   We then compute the ratio of the current x-height to our font's x-height;
%   this is the "\FranklinGothic@scale" we will pass to the .fd files.
\ifthenelse{\equal{\FranklinGothic@scale}{MatchLowercase}}
    {   \newlength{\FranklinGothic@currentx}
        \settoheight{\FranklinGothic@currentx}{x}
        \newlength{\FranklinGothic@xheight}
        \settoheight{\FranklinGothic@xheight}
            {{\font\testfont=FranklinGothic-Book-tlf-t1 at \f@size pt\testfont x}}
        \renewcommand*{\FranklinGothic@scale}
            {\strip@pt\dimexpr\number\numexpr\number\dimexpr\FranklinGothic@currentx\relax*65536/\number\dimexpr\FranklinGothic@xheight\relax\relax sp\relax}}
    {}

\renewcommand*
    {\rmdefault}
    {FranklinGothic-\FranklinGothic@figurealign\FranklinGothic@figurestyle}

\endinput
