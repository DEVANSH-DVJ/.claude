\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Verdana}
    [2026/10/03 (autoinst)  Style file for Verdana fonts.]

\RequirePackage{xkeyval}
\newcommand*{\Verdana@scale}{1}
\DeclareOptionX{scale}{\renewcommand*{\Verdana@scale}{#1}}
\DeclareOptionX{scaled}{\renewcommand*{\Verdana@scale}{#1}}

\DeclareOptionX{lining}{\edef\Verdana@figurestyle{LF}}
\DeclareOptionX{oldstyle}{\edef\Verdana@figurestyle{OsF}}
\DeclareOptionX{tabular}{\edef\Verdana@figurealign{T}}
\DeclareOptionX{proportional}{\edef\Verdana@figurealign{}}
\edef\Verdana@figurestyle{OsF}
\edef\Verdana@figurealign{}

\DeclareOptionX{mainfont}{
    \renewcommand{\familydefault}{\rmdefault}
}
\DeclareOptionX{bold}{\edef\bfseries@rm{bold}}
\DeclareOptionX{regular}{\edef\mdseries@rm{regular}}

\ProcessOptionsX\relax

\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}
\RequirePackage{ifthen}
\RequirePackage{mweights}

\IfFileExists{fontaxes.sty}{
    \RequirePackage{fontaxes}
    \fa@naming@exception{figures}{{superior}{proportional}}{Sup}
    \fa@naming@exception{figures}{{superior}{tabular}}{Sup}
    \def\supfigures{\@nomath\supfigures
        \fontfigurestyle{superior}\selectfont}
    \let\sufigures\supfigures
    \DeclareTextFontCommand{\textsup}{\supfigures}
    \let\textsu\textsup
    \let\textsuperior\textsup
    \let\@oldtextsuperscript\textsuperscript
    \def\textsuperscript{\@ifstar\@oldtextsuperscript\textsup}
    \def\@makefnmark{%
        \mbox{\footnotemarkfont\textsuperscript{\@thefnmark}}}
    \@ifundefined{ftntm@font}%
        {\let\footnotemarkfont\normalfont}%
        {\let\footnotemarkfont\ftntm@font}

}{}

%   Here we implement the scale=MatchLowercase option.
%   If this is given, we must compute the correct value of
%   the "\Verdana@scale" parameter before loading the .fd files;
%   but to determine that value we of course need the font's x-height.
%   To avoid triggering the loading of .fd files,
%   we use plain TeX's \font primitive to load the testfont.
%   We then compute the ratio of the current x-height to our font's x-height;
%   this is the "\Verdana@scale" we will pass to the .fd files.
\ifthenelse{\equal{\Verdana@scale}{MatchLowercase}}
    {   \newlength{\Verdana@currentx}
        \settoheight{\Verdana@currentx}{x}
        \newlength{\Verdana@xheight}
        \settoheight{\Verdana@xheight}
            {{\font\testfont=Verdana-osf-t1 at \f@size pt\testfont x}}
        \renewcommand*{\Verdana@scale}
            {\strip@pt\dimexpr\number\numexpr\number\dimexpr\Verdana@currentx\relax*65536/\number\dimexpr\Verdana@xheight\relax\relax sp\relax}}
    {}

\renewcommand*
    {\rmdefault}
    {Verdana-\Verdana@figurealign\Verdana@figurestyle}

\endinput
