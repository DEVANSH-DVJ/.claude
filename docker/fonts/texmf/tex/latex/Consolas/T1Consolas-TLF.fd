\ProvidesFile{T1Consolas-TLF.fd}
    [2026/10/03 (autoinst)  Font definitions for T1/Consolas-TLF.]

\ifcsname s@fct@alias\endcsname\else
\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname Consolas@scale\endcsname\relax
    \let\Consolas@@scale\@empty
\else
    \edef\Consolas@@scale{s*[\csname Consolas@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{Consolas-TLF}{\hyphenchar\font=-1}


%   ----  b = bold  ----

\DeclareFontShape{T1}{Consolas-TLF}{b}{n}{
      <-> \Consolas@@scale Consolas-Bold-tlf-t1
}{}

\DeclareFontShape{T1}{Consolas-TLF}{bold}{n}{
      <-> alias * Consolas-TLF/b/n
}{}

\DeclareFontShape{T1}{Consolas-TLF}{b}{it}{
      <-> \Consolas@@scale Consolas-BoldItalic-tlf-t1
}{}

\DeclareFontShape{T1}{Consolas-TLF}{bold}{it}{
      <-> alias * Consolas-TLF/b/it
}{}

\DeclareFontShape{T1}{Consolas-TLF}{b}{sl}{
    <-> ssub * Consolas-TLF/b/it
}{}

\DeclareFontShape{T1}{Consolas-TLF}{bold}{sl}{
    <-> ssub * Consolas-TLF/bold/it
}{}


%   ----  m = regular  ----

\DeclareFontShape{T1}{Consolas-TLF}{m}{n}{
      <-> \Consolas@@scale Consolas-tlf-t1
}{}

\DeclareFontShape{T1}{Consolas-TLF}{regular}{n}{
      <-> alias * Consolas-TLF/m/n
}{}

\DeclareFontShape{T1}{Consolas-TLF}{m}{it}{
      <-> \Consolas@@scale Consolas-Italic-tlf-t1
}{}

\DeclareFontShape{T1}{Consolas-TLF}{regular}{it}{
      <-> alias * Consolas-TLF/m/it
}{}

\DeclareFontShape{T1}{Consolas-TLF}{m}{sl}{
    <-> ssub * Consolas-TLF/m/it
}{}

\DeclareFontShape{T1}{Consolas-TLF}{regular}{sl}{
    <-> ssub * Consolas-TLF/regular/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{T1}{Consolas-TLF}{bx}{n}{
      <-> ssub * Consolas-TLF/b/n
}{}

\DeclareFontShape{T1}{Consolas-TLF}{bx}{it}{
      <-> ssub * Consolas-TLF/b/it
}{}

\DeclareFontShape{T1}{Consolas-TLF}{bx}{sl}{
      <-> ssub * Consolas-TLF/b/sl
}{}

