\ifcsname s@fct@alias\endcsname\else
\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname Consolas@scale\endcsname\relax
    \let\Consolas@@scale\@empty
\else
    \edef\Consolas@@scale{s*[\csname Consolas@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Consolas-TOsF}{\hyphenchar\font=-1}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Consolas-TOsF}{b}{it}{
      <-> \Consolas@@scale Consolas-BoldItalic-tosf-ts1
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{bold}{it}{
      <-> alias * Consolas-TOsF/b/it
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{b}{n}{
      <-> \Consolas@@scale Consolas-Bold-tosf-ts1
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{bold}{n}{
      <-> alias * Consolas-TOsF/b/n
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{b}{sl}{
    <-> ssub * Consolas-TOsF/b/it
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{bold}{sl}{
    <-> ssub * Consolas-TOsF/bold/it
}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Consolas-TOsF}{m}{it}{
      <-> \Consolas@@scale Consolas-Italic-tosf-ts1
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{regular}{it}{
      <-> alias * Consolas-TOsF/m/it
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{m}{n}{
      <-> \Consolas@@scale Consolas-tosf-ts1
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{regular}{n}{
      <-> alias * Consolas-TOsF/m/n
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{m}{sl}{
    <-> ssub * Consolas-TOsF/m/it
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{regular}{sl}{
    <-> ssub * Consolas-TOsF/regular/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Consolas-TOsF}{bx}{sl}{
      <-> ssub * Consolas-TOsF/b/sl
}{}

\DeclareFontShape{TS1}{Consolas-TOsF}{bx}{n}{
