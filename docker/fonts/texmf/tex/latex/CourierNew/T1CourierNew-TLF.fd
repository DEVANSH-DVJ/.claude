\ProvidesFile{T1CourierNew-TLF.fd}
    [2026/10/03 (autoinst)  Font definitions for T1/CourierNew-TLF.]

\ifcsname s@fct@alias\endcsname\else
\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname CourierNew@scale\endcsname\relax
    \let\CourierNew@@scale\@empty
\else
    \edef\CourierNew@@scale{s*[\csname CourierNew@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{CourierNew-TLF}{\hyphenchar\font=-1}


%   ----  m = regular  ----

\DeclareFontShape{T1}{CourierNew-TLF}{m}{n}{
      <-> \CourierNew@@scale CourierNewPSMT-tlf-t1
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{regular}{n}{
      <-> alias * CourierNew-TLF/m/n
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{m}{it}{
      <-> \CourierNew@@scale CourierNewPS-ItalicMT-tlf-t1
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{regular}{it}{
      <-> alias * CourierNew-TLF/m/it
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{m}{sl}{
    <-> ssub * CourierNew-TLF/m/it
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{regular}{sl}{
    <-> ssub * CourierNew-TLF/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{T1}{CourierNew-TLF}{b}{n}{
      <-> \CourierNew@@scale CourierNewPS-BoldMT-tlf-t1
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{bold}{n}{
      <-> alias * CourierNew-TLF/b/n
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{b}{it}{
      <-> \CourierNew@@scale CourierNewPS-BoldItalicMT-tlf-t1
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{bold}{it}{
      <-> alias * CourierNew-TLF/b/it
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{b}{sl}{
    <-> ssub * CourierNew-TLF/b/it
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{bold}{sl}{
    <-> ssub * CourierNew-TLF/bold/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{T1}{CourierNew-TLF}{bx}{sl}{
      <-> ssub * CourierNew-TLF/b/sl
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{bx}{it}{
      <-> ssub * CourierNew-TLF/b/it
}{}

\DeclareFontShape{T1}{CourierNew-TLF}{bx}{n}{
      <-> ssub * CourierNew-TLF/b/n
}{}

