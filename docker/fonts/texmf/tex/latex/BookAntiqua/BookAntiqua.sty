\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{BookAntiqua}
    [2026/10/03 (autoinst)  Style file for BookAntiqua fonts.]

\RequirePackage{xkeyval}
\newcommand*{\BookAntiqua@scale}{1}
\DeclareOptionX{scale}{\renewcommand*{\BookAntiqua@scale}{#1}}
\DeclareOptionX{scaled}{\renewcommand*{\BookAntiqua@scale}{#1}}

\DeclareOptionX{lining}{\edef\BookAntiqua@figurestyle{LF}}
\DeclareOptionX{tabular}{\edef\BookAntiqua@figurealign{T}}
\edef\BookAntiqua@figurestyle{LF}
\edef\BookAntiqua@figurealign{T}

\DeclareOptionX{mainfont}{
    \renewcommand{\familydefault}{\rmdefault}
}
\DeclareOptionX{bold}{\edef\bfseries@rm{bold}}
\DeclareOptionX{regular}{\edef\mdseries@rm{regular}}

\ProcessOptionsX\relax

\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}
\RequirePackage{ifthen}
\RequirePackage{mweights}

\IfFileExists{fontaxes.sty}{
    \RequirePackage{fontaxes}
}{}

%   Here we implement the scale=MatchLowercase option.
%   If this is given, we must compute the correct value of
%   the "\BookAntiqua@scale" parameter before loading the .fd files;
%   but to determine that value we of course need the font's x-height.
%   To avoid triggering the loading of .fd files,
%   we use plain TeX's \font primitive to load the testfont.
%   We then compute the ratio of the current x-height to our font's x-height;
%   this is the "\BookAntiqua@scale" we will pass to the .fd files.
\ifthenelse{\equal{\BookAntiqua@scale}{MatchLowercase}}
    {   \newlength{\BookAntiqua@currentx}
        \settoheight{\BookAntiqua@currentx}{x}
        \newlength{\BookAntiqua@xheight}
        \settoheight{\BookAntiqua@xheight}
            {{\font\testfont=BookAntiqua-tlf-t1 at \f@size pt\testfont x}}
        \renewcommand*{\BookAntiqua@scale}
            {\strip@pt\dimexpr\number\numexpr\number\dimexpr\BookAntiqua@currentx\relax*65536/\number\dimexpr\BookAntiqua@xheight\relax\relax sp\relax}}
    {}

\renewcommand*
    {\rmdefault}
    {BookAntiqua-\BookAntiqua@figurealign\BookAntiqua@figurestyle}

\endinput
