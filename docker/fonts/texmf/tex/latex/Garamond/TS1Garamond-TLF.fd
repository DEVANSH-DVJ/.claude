\ifcsname s@fct@alias\endcsname\else
\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname Garamond@scale\endcsname\relax
    \let\Garamond@@scale\@empty
\else
    \edef\Garamond@@scale{s*[\csname Garamond@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Garamond-TLF}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Garamond-TLF}{b}{n}{
      <-> \Garamond@@scale Garamond-Bold-tlf-ts1
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{bold}{n}{
      <-> alias * Garamond-TLF/b/n
}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Garamond-TLF}{m}{it}{
      <-> \Garamond@@scale Garamond-Italic-tlf-ts1
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{regular}{it}{
      <-> alias * Garamond-TLF/m/it
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{m}{n}{
      <-> \Garamond@@scale Garamond-tlf-ts1
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{regular}{n}{
      <-> alias * Garamond-TLF/m/n
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{m}{sl}{
    <-> ssub * Garamond-TLF/m/it
}{}

\DeclareFontShape{TS1}{Garamond-TLF}{regular}{sl}{
    <-> ssub * Garamond-TLF/regular/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Garamond-TLF}{bx}{n}{
      <-> ssub * Garamond-TLF/b/n
}{}

