\expandafter\ifx\csname Cambria@scale\endcsname\relax
    \let\Cambria@@scale\@empty
\else
    \edef\Cambria@@scale{s*[\csname Cambria@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{Cambria-Sup}{}


%   ----  m = regular  ----

\DeclareFontShape{T1}{Cambria-Sup}{m}{it}{
      <-> \Cambria@@scale Cambria-Italic-sup-t1
}{}

\DeclareFontShape{T1}{Cambria-Sup}{regular}{it}{
      <-> alias * Cambria-Sup/m/it
}{}

\DeclareFontShape{T1}{Cambria-Sup}{m}{n}{
      <-> \Cambria@@scale Cambria-sup-t1
}{}

\DeclareFontShape{T1}{Cambria-Sup}{regular}{n}{
      <-> alias * Cambria-Sup/m/n
}{}

\DeclareFontShape{T1}{Cambria-Sup}{m}{sl}{
    <-> ssub * Cambria-Sup/m/it
}{}

\DeclareFontShape{T1}{Cambria-Sup}{regular}{sl}{
    <-> ssub * Cambria-Sup/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{T1}{Cambria-Sup}{b}{n}{
      <-> \Cambria@@scale Cambria-Bold-sup-t1
}{}

\DeclareFontShape{T1}{Cambria-Sup}{bold}{n}{
      <-> alias * Cambria-Sup/b/n
}{}

\DeclareFontShape{T1}{Cambria-Sup}{b}{it}{
      <-> \Cambria@@scale Cambria-BoldItalic-sup-t1
}{}

\DeclareFontShape{T1}{Cambria-Sup}{bold}{it}{
      <-> alias * Cambria-Sup/b/it
}{}

\DeclareFontShape{T1}{Cambria-Sup}{b}{sl}{
    <-> ssub * Cambria-Sup/b/it
}{}

\DeclareFontShape{T1}{Cambria-Sup}{bold}{sl}{
    <-> ssub * Cambria-Sup/bold/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{T1}{Cambria-Sup}{bx}{n}{
      <-> ssub * Cambria-Sup/b/n
}{}

\DeclareFontShape{T1}{Cambria-Sup}{bx}{it}{
      <-> ssub * Cambria-Sup/b/it
}{}

\DeclareFontShape{T1}{Cambria-Sup}{bx}{sl}{
