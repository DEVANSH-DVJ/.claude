\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname Cambria@scale\endcsname\relax
    \let\Cambria@@scale\@empty
\else
    \edef\Cambria@@scale{s*[\csname Cambria@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Cambria-LF}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Cambria-LF}{m}{it}{
      <-> \Cambria@@scale Cambria-Italic-lf-ts1
}{}

\DeclareFontShape{TS1}{Cambria-LF}{regular}{it}{
      <-> alias * Cambria-LF/m/it
}{}

\DeclareFontShape{TS1}{Cambria-LF}{m}{n}{
      <-> \Cambria@@scale Cambria-lf-ts1
}{}

\DeclareFontShape{TS1}{Cambria-LF}{regular}{n}{
      <-> alias * Cambria-LF/m/n
}{}

\DeclareFontShape{TS1}{Cambria-LF}{m}{sl}{
    <-> ssub * Cambria-LF/m/it
}{}

\DeclareFontShape{TS1}{Cambria-LF}{regular}{sl}{
    <-> ssub * Cambria-LF/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Cambria-LF}{b}{it}{
      <-> \Cambria@@scale Cambria-BoldItalic-lf-ts1
}{}

\DeclareFontShape{TS1}{Cambria-LF}{bold}{it}{
      <-> alias * Cambria-LF/b/it
}{}

\DeclareFontShape{TS1}{Cambria-LF}{b}{n}{
      <-> \Cambria@@scale Cambria-Bold-lf-ts1
}{}

\DeclareFontShape{TS1}{Cambria-LF}{bold}{n}{
      <-> alias * Cambria-LF/b/n
}{}

\DeclareFontShape{TS1}{Cambria-LF}{b}{sl}{
    <-> ssub * Cambria-LF/b/it
}{}

\DeclareFontShape{TS1}{Cambria-LF}{bold}{sl}{
    <-> ssub * Cambria-LF/bold/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Cambria-LF}{bx}{it}{
      <-> ssub * Cambria-LF/b/it
}{}

\DeclareFontShape{TS1}{Cambria-LF}{bx}{sl}{
      <-> ssub * Cambria-LF/b/sl
}{}

\DeclareFontShape{TS1}{Cambria-LF}{bx}{n}{
