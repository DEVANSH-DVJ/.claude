}{}

\DeclareFontShape{TS1}{Cambria-TLF}{b}{sl}{
    <-> ssub * Cambria-TLF/b/it
}{}

\DeclareFontShape{TS1}{Cambria-TLF}{bold}{sl}{
    <-> ssub * Cambria-TLF/bold/it
