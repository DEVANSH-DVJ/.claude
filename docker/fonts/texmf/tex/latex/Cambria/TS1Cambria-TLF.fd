}{}

\DeclareFontShape{TS1}{Cambria-TLF}{m}{sl}{
    <-> ssub * Cambria-TLF/m/it
}{}

\DeclareFontShape{TS1}{Cambria-TLF}{regular}{sl}{
    <-> ssub * Cambria-TLF/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Cambria-TLF}{b}{it}{
      <-> \Cambria@@scale Cambria-BoldItalic-tlf-ts1
}{}

\DeclareFontShape{TS1}{Cambria-TLF}{bold}{it}{
