}{}

\DeclareFontShape{TS1}{Arial-LF}{m}{sl}{
    <-> ssub * Arial-LF/m/it
}{}

\DeclareFontShape{TS1}{Arial-LF}{regular}{sl}{
    <-> ssub * Arial-LF/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Arial-LF}{b}{it}{
      <-> \Arial@@scale Arial-BoldItalicMT-lf-ts1
}{}

\DeclareFontShape{TS1}{Arial-LF}{bold}{it}{
      <-> alias * Arial-LF/b/it
}{}

\DeclareFontShape{TS1}{Arial-LF}{b}{n}{
      <-> \Arial@@scale Arial-BoldMT-lf-ts1
}{}

\DeclareFontShape{TS1}{Arial-LF}{bold}{n}{
      <-> alias * Arial-LF/b/n
}{}

\DeclareFontShape{TS1}{Arial-LF}{b}{sl}{
    <-> ssub * Arial-LF/b/it
}{}

\DeclareFontShape{TS1}{Arial-LF}{bold}{sl}{
    <-> ssub * Arial-LF/bold/it
}{}


%   ----  eb = black  ----

\DeclareFontShape{TS1}{Arial-LF}{eb}{n}{
      <-> \Arial@@scale Arial-Black-lf-ts1
}{}

\DeclareFontShape{TS1}{Arial-LF}{black}{n}{
      <-> alias * Arial-LF/eb/n
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Arial-LF}{bx}{n}{
      <-> ssub * Arial-LF/b/n
}{}

\DeclareFontShape{TS1}{Arial-LF}{bx}{sl}{
