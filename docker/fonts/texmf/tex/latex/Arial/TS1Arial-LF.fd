\expandafter\ifx\csname Arial@scale\endcsname\relax
    \let\Arial@@scale\@empty
\else
    \edef\Arial@@scale{s*[\csname Arial@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Arial-LF}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Arial-LF}{m}{n}{
      <-> \Arial@@scale ArialMT-lf-ts1
}{}

\DeclareFontShape{TS1}{Arial-LF}{regular}{n}{
      <-> alias * Arial-LF/m/n
}{}

\DeclareFontShape{TS1}{Arial-LF}{m}{it}{
