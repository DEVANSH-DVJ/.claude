      <-> \Arial@@scale Arial-BoldMT-tosf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{bold}{n}{
      <-> alias * Arial-TOsF/b/n
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{b}{sl}{
    <-> ssub * Arial-TOsF/b/it
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{bold}{sl}{
    <-> ssub * Arial-TOsF/bold/it
}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Arial-TOsF}{m}{n}{
      <-> \Arial@@scale ArialMT-tosf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{regular}{n}{
      <-> alias * Arial-TOsF/m/n
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{m}{it}{
      <-> \Arial@@scale Arial-ItalicMT-tosf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{regular}{it}{
      <-> alias * Arial-TOsF/m/it
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{m}{sl}{
    <-> ssub * Arial-TOsF/m/it
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{regular}{sl}{
    <-> ssub * Arial-TOsF/regular/it
}{}


%   ----  eb = black  ----

\DeclareFontShape{TS1}{Arial-TOsF}{eb}{n}{
      <-> \Arial@@scale Arial-Black-tosf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{black}{n}{
      <-> alias * Arial-TOsF/eb/n
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

