\expandafter\ifx\csname Arial@scale\endcsname\relax
    \let\Arial@@scale\@empty
\else
    \edef\Arial@@scale{s*[\csname Arial@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Arial-TOsF}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Arial-TOsF}{b}{it}{
      <-> \Arial@@scale Arial-BoldItalicMT-tosf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TOsF}{bold}{it}{
