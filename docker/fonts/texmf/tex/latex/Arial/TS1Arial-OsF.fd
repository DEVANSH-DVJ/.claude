\expandafter\ifx\csname Arial@scale\endcsname\relax
    \let\Arial@@scale\@empty
\else
    \edef\Arial@@scale{s*[\csname Arial@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Arial-OsF}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Arial-OsF}{m}{n}{
      <-> \Arial@@scale ArialMT-osf-ts1
}{}

\DeclareFontShape{TS1}{Arial-OsF}{regular}{n}{
