      <-> \Arial@@scale Arial-BoldMT-osf-ts1
}{}

\DeclareFontShape{TS1}{Arial-OsF}{bold}{n}{
      <-> alias * Arial-OsF/b/n
}{}

\DeclareFontShape{TS1}{Arial-OsF}{b}{sl}{
    <-> ssub * Arial-OsF/b/it
}{}

\DeclareFontShape{TS1}{Arial-OsF}{bold}{sl}{
    <-> ssub * Arial-OsF/bold/it
}{}


%   ----  eb = black  ----

\DeclareFontShape{TS1}{Arial-OsF}{eb}{n}{
      <-> \Arial@@scale Arial-Black-osf-ts1
}{}

\DeclareFontShape{TS1}{Arial-OsF}{black}{n}{
      <-> alias * Arial-OsF/eb/n
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Arial-OsF}{bx}{n}{
