}{}

\DeclareFontShape{TS1}{Arial-OsF}{m}{sl}{
    <-> ssub * Arial-OsF/m/it
}{}

\DeclareFontShape{TS1}{Arial-OsF}{regular}{sl}{
    <-> ssub * Arial-OsF/regular/it
}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Arial-OsF}{b}{it}{
      <-> \Arial@@scale Arial-BoldItalicMT-osf-ts1
}{}

\DeclareFontShape{TS1}{Arial-OsF}{bold}{it}{
      <-> alias * Arial-OsF/b/it
}{}

