\ProvidesFile{TS1Arial-TLF.fd}
    [2026/10/03 (autoinst)  Font definitions for TS1/Arial-TLF.]

\ifcsname s@fct@alias\endcsname\else
\gdef\s@fct@alias{\sub@sfcnt\@font@aliasinfo}
\gdef\@font@aliasinfo#1{%
    \@font@info{Font\space shape\space `\curr@fontshape'\space will
        \space be\space aliased\MessageBreak to\space `\mandatory@arg'}%
}
\fi

\expandafter\ifx\csname Arial@scale\endcsname\relax
    \let\Arial@@scale\@empty
\else
    \edef\Arial@@scale{s*[\csname Arial@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{Arial-TLF}{}


%   ----  eb = black  ----

\DeclareFontShape{TS1}{Arial-TLF}{eb}{n}{
      <-> \Arial@@scale Arial-Black-tlf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TLF}{black}{n}{
      <-> alias * Arial-TLF/eb/n
}{}


%   ----  b = bold  ----

\DeclareFontShape{TS1}{Arial-TLF}{b}{n}{
      <-> \Arial@@scale Arial-BoldMT-tlf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TLF}{bold}{n}{
      <-> alias * Arial-TLF/b/n
}{}

\DeclareFontShape{TS1}{Arial-TLF}{b}{it}{
      <-> \Arial@@scale Arial-BoldItalicMT-tlf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TLF}{bold}{it}{
      <-> alias * Arial-TLF/b/it
}{}

\DeclareFontShape{TS1}{Arial-TLF}{b}{sl}{
    <-> ssub * Arial-TLF/b/it
}{}

\DeclareFontShape{TS1}{Arial-TLF}{bold}{sl}{
    <-> ssub * Arial-TLF/bold/it
}{}


%   ----  m = regular  ----

\DeclareFontShape{TS1}{Arial-TLF}{m}{n}{
      <-> \Arial@@scale ArialMT-tlf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TLF}{regular}{n}{
      <-> alias * Arial-TLF/m/n
}{}

\DeclareFontShape{TS1}{Arial-TLF}{m}{it}{
      <-> \Arial@@scale Arial-ItalicMT-tlf-ts1
}{}

\DeclareFontShape{TS1}{Arial-TLF}{regular}{it}{
      <-> alias * Arial-TLF/m/it
}{}

\DeclareFontShape{TS1}{Arial-TLF}{m}{sl}{
    <-> ssub * Arial-TLF/m/it
}{}

\DeclareFontShape{TS1}{Arial-TLF}{regular}{sl}{
    <-> ssub * Arial-TLF/regular/it
}{}


%   ----  Extra 'ssub' rules to map 'bx' to 'b'  ----

\DeclareFontShape{TS1}{Arial-TLF}{bx}{n}{
      <-> ssub * Arial-TLF/b/n
}{}

\DeclareFontShape{TS1}{Arial-TLF}{bx}{it}{
      <-> ssub * Arial-TLF/b/it
}{}

\DeclareFontShape{TS1}{Arial-TLF}{bx}{sl}{
      <-> ssub * Arial-TLF/b/sl
}{}

