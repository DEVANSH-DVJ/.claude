# Template dev image. Edit the blocks below for the project's toolchain.
# build.sh builds this with context `..` (the repo root), so COPY paths start with docker/.
# Runtime code is bind-mounted at /workspace; exec.sh overrides the entrypoint with bash.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

# system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
      sudo curl wget git ca-certificates build-essential pkg-config \
      nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# miniconda + conda env
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH
RUN curl -fsSL "https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-$(uname -m).sh" -o /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p "$CONDA_DIR" \
    && rm /tmp/miniconda.sh
COPY docker/environment.yml /tmp/environment.yml
RUN conda env update -n base -f /tmp/environment.yml && conda clean -afy

# rust / cargo
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=$CARGO_HOME/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --component clippy

# formatters, grouped last so they are easy to edit
RUN apt-get update && apt-get install -y --no-install-recommends shfmt clang-format \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g prettier \
    && rustup component add rustfmt

# interactive entrypoint (exec.sh overrides this with bash)
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
